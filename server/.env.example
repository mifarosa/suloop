# Bu dosyayı server/.env olarak kopyala. Varsayılanlar suloop'un kendi Firebase projesine göre
# hazır; yerelde denemek için hiçbir şeyi değiştirmen gerekmez. .env'i depoya koyma.

# Oyuncuların Google ile girdiği Firebase projesi (yalnız giriş için; veri bu sunucuda durur).
# Projenin adını belirtir, gizli bir değer değildir.
FIREBASE_PROJECT_ID=suloop-8ee05

# Sunucuyu çağırabilecek sayfalar, virgülle ayrılmış. Yerelde oyunun geliştirme adresi;
# canlıya açınca https://mifarosa.com da eklenir.
ALLOWED_ORIGIN=http://localhost:5173

# Oturum çerezi yalnız HTTPS'te gitsin mi? Yerelde (http://localhost) false, HTTPS adreste true.
COOKIE_SECURE=false

# İsteğe bağlı:
# PORT=3000
# LOG_LEVEL=info
