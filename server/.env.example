# Bu dosyayı server/.env olarak kopyala ve doldur. .env'i depoya koyma.

# Google Cloud Console'da açtığın OAuth istemci kimliği (Web), "….apps.googleusercontent.com".
GOOGLE_CLIENT_ID=

# Sunucuyu çağırabilecek sayfalar, virgülle ayrılmış. Yerelde oyunun geliştirme adresi;
# canlıya açınca https://mifarosa.com da eklenir.
ALLOWED_ORIGIN=http://localhost:5173

# Oturum çerezi yalnız HTTPS'te gitsin mi? Yerelde (http://localhost) false, HTTPS adreste true.
COOKIE_SECURE=false

# İsteğe bağlı:
# PORT=3000
# LOG_LEVEL=info
