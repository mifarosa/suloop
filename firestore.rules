rules_version = '2';

// Who may read and write what in the game's Firestore database. Deploy with
//   firebase deploy --only firestore
// or paste this file into Firebase console → Firestore Database → Rules (see docs/firebase.md).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A username is claimed by writing usernames/{lower case name} and the player's profile
    // in one step, so a name never has two owners. Names can be looked up one by one, not listed.
    match /usernames/{lower} {
      allow get: if true;
      allow create: if signedIn()
        && lower.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.usernameLower == lower;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // What everyone may see of a player: their username.
    match /profiles/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,20}$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      allow delete: if isOwner(uid);
    }

    // A player's progress: only they can see or change it.
    match /progress/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
          ['solved', 'current', 'hints', 'spareUndos', 'records', 'dailyDone', 'daily', 'updatedAt'])
        && request.resource.data.solved is int
        && request.resource.data.solved >= 0
        && request.resource.data.solved <= 100000
        && request.resource.data.current is int
        && request.resource.data.current >= 1
        && request.resource.data.hints is int
        && request.resource.data.hints >= 0
        && request.resource.data.hints <= 1000000
        && request.resource.data.spareUndos is int
        && request.resource.data.spareUndos >= 0
        && request.resource.data.spareUndos <= 50
        && request.resource.data.records is map
        && (request.resource.data.dailyDone == null || request.resource.data.dailyDone is string)
        && request.resource.data.daily is map
        && request.resource.data.daily.size() <= 60
        && request.resource.data.updatedAt == request.time;
    }

    // Whether a date key such as "2026-10-12" is a day close to now: the player's own day can
    // be up to a day off from the server's, in either direction.
    function isNearDay(day) {
      let date = timestamp.date(int(day[0:4]), int(day[5:7]), int(day[8:10]));
      return request.time >= date - duration.value(1, 'd')
        && request.time < date + duration.value(2, 'd');
    }

    // The daily puzzle's scores: anyone can read them, and a player adds their own once a day,
    // under the username they chose. A score is never changed from the game, except the one of
    // the day the puzzle got rules, which is replaced once (a score that does not hold up is
    // removed by the server that checks them).
    match /daily/{day}/scores/{uid} {
      allow read: if true;
      allow create: if validScore(uid, day);
      // The score of the day's puzzle before it had rules is replaced once, by version 2.
      allow update: if resource.data.get('v', 1) < 2 && validScore(uid, day);
    }

    function validScore(uid, day) {
      return isOwner(uid)
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isNearDay(day)
        && request.resource.data.keys().hasOnly(
          ['username', 'moves', 'seconds', 'stars', 'score', 'rank', 'createdAt', 'v'])
        && request.resource.data.v == 2
        && request.resource.data.username
          == get(/databases/$(database)/documents/profiles/$(uid)).data.username
        && request.resource.data.moves is int
        && request.resource.data.moves >= 1
        && request.resource.data.moves <= 999
        && request.resource.data.seconds is int
        && request.resource.data.seconds >= 1
        && request.resource.data.seconds <= 86400
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 3
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000
        && request.resource.data.rank
          == request.resource.data.score * 100000 + (99999 - request.resource.data.seconds)
        && request.resource.data.createdAt == request.time;
    }

    // The moves behind a daily score, for checking it later. Written once, and read only by
    // the server that checks them (the Admin SDK is not bound by these rules).
    match /dailyMoves/{id} {
      allow create: if validMoves(id);
      allow update: if resource.data.get('v', 1) < 2 && validMoves(id);
    }

    function validMoves(id) {
      return signedIn()
        && id == request.resource.data.day + '_' + request.auth.uid
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['day', 'moves', 'hints', 'createdAt', 'v'])
        && request.resource.data.v == 2
        && request.resource.data.moves is list
        && request.resource.data.moves.size() >= 1
        && request.resource.data.moves.size() <= 400
        && request.resource.data.hints is int
        && request.resource.data.hints >= 0
        && request.resource.data.hints <= 999
        && request.resource.data.createdAt == request.time;
    }
  }
}
