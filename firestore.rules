rules_version = '2';

// Who may read and write what in the game's Firestore database. Deploy with
//   firebase deploy --only firestore
// or paste this file into Firebase console → Firestore Database → Rules (see docs/firebase.md).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A username is claimed by writing usernames/{lower case name} and the player's profile
    // in one step, so a name never has two owners. Names can be looked up one by one, not listed.
    match /usernames/{lower} {
      allow get: if true;
      allow create: if signedIn()
        && lower.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.usernameLower == lower;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // What everyone may see of a player: their username.
    match /profiles/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'createdAt'])
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[A-Za-z0-9_]{3,20}$')
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == uid;
      allow delete: if isOwner(uid);
    }

    // A player's progress: only they can see or change it.
    match /progress/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(
          ['solved', 'current', 'hints', 'spareUndos', 'records', 'dailyDone', 'daily', 'updatedAt'])
        && request.resource.data.solved is int
        && request.resource.data.solved >= 0
        && request.resource.data.solved <= 100000
        && request.resource.data.current is int
        && request.resource.data.current >= 1
        && request.resource.data.hints is int
        && request.resource.data.hints >= 0
        && request.resource.data.hints <= 1000000
        && request.resource.data.spareUndos is int
        && request.resource.data.spareUndos >= 0
        && request.resource.data.spareUndos <= 50
        && request.resource.data.records is map
        && (request.resource.data.dailyDone == null || request.resource.data.dailyDone is string)
        && request.resource.data.daily is map
        && request.resource.data.daily.size() <= 60
        && request.resource.data.updatedAt == request.time;
    }
  }
}
