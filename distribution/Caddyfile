{$DOMAIN} {
	root * /srv
	file_server

	# Always the latest build; a phone must never install a cached older one.
	header Cache-Control "no-store"

	@apk path *.apk
	header @apk Content-Type "application/vnd.android.package-archive"
	@ipa path *.ipa
	header @ipa Content-Type "application/octet-stream"
	@plist path *.plist
	header @plist Content-Type "text/xml"
}
